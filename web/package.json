{
  "name": "djound-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/api-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm generate && tsc --noEmit && vite build",
    "format": "prettier --write \"app/*.{js,css,html}\" src vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check \"app/*.{js,css,html}\" src vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "test": "node --experimental-strip-types --test src/recovery.test.ts src/renditions/songTime.test.ts",
    "test:entry": "node ../scripts/web-entry-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.7",
    "openapi-typescript": "7.10.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.22.2"
  }
}
