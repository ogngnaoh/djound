{
  "name": "djound-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/api-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm generate && tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html pnpm-workspace.yaml",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html pnpm-workspace.yaml",
    "test": "node --experimental-strip-types --test src/editor/state.test.ts src/recovery.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tanstack/react-query": "5.90.16",
    "openapi-fetch": "0.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "fake-indexeddb": "6.2.7",
    "openapi-typescript": "7.10.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.22.2"
  }
}
